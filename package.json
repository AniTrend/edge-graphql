{
  "name": "edge-graphql",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mesh-compose -o supergraph.graphql && hive-gateway supergraph",
    "start": "mesh-compose -o supergraph.graphql && hive-gateway supergraph",
    "build": "mesh-compose -o supergraph.graphql",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.js\"",
    "test:contract": "node --test tests/openapi-contract.spec.js",
    "pretest:surface": "npm run build",
    "test:surface": "node --test tests/graphql-surface.spec.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "dotenv": "^18.0.0",
    "graphql": "^16.8.1",
    "@graphql-hive/gateway": "^2.3.0",
    "@graphql-mesh/compose-cli": "^1.5.9",
    "@omnigraph/openapi": "^0.112.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.21.0",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "axios": "1.21.0",
    "@grpc/grpc-js": "1.14.7",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/propagator-jaeger": "2.12.0",
    "fast-uri": "4.2.3",
    "form-data": "4.0.6",
    "glob@10.5.0": {
      "minimatch": {
        "brace-expansion": "2.1.7"
      }
    },
    "js-yaml": "4.3.2",
    "protobufjs": "8.8.1",
    "uuid": "14.0.3",
    "@graphql-hive/gateway-runtime": {
      "@graphql-hive/yoga": "0.49.9",
      "@graphql-yoga/plugin-apollo-usage-report": "0.19.6"
    }
  }
}
