{
  "name": "edge-graphql",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mesh-compose -o supergraph.graphql && hive-gateway supergraph",
    "start": "mesh-compose -o supergraph.graphql && hive-gateway supergraph",
    "build": "mesh-compose -o supergraph.graphql",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.js\"",
    "test:contract": "node --test tests/openapi-contract.spec.js",
    "pretest:surface": "npm run build",
    "test:surface": "node --test tests/graphql-surface.spec.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "dotenv": "^17.0.0",
    "graphql": "^16.8.1",
    "@graphql-hive/gateway": "^2.3.0",
    "@graphql-mesh/compose-cli": "^1.5.9",
    "@omnigraph/openapi": "^0.109.29"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.21.0",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "@opentelemetry/core": "2.10.0",
    "fast-uri": "4.1.2",
    "form-data": "4.0.6",
    "js-yaml": "4.3.1",
    "protobufjs": "8.7.1",
    "uuid": "14.0.1"
  }
}
